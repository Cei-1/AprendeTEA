@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        let currentStep = 1;


        document.addEventListener("DOMContentLoaded", () => {

            const palabras = "@Model.PalabrasSopa".split(",").map(p => p.trim().toUpperCase());
            const gridSize = 12;
            let grid = [];

            // Genera una matriz vacía
            for (let i = 0; i < gridSize; i++) {
                grid[i] = [];
                for (let j = 0; j < gridSize; j++) {
                    grid[i][j] = "";
                }
            }

            // Intenta colocar cada palabra horizontalmente
            palabras.forEach(palabra => {
                let placed = false;
                let attempts = 0;

                while (!placed && attempts < 50) {
                    attempts++;
                    let row = Math.floor(Math.random() * gridSize);
                    let col = Math.floor(Math.random() * (gridSize - palabra.length));

                    // Validar espacio
                    let fits = true;
                    for (let i = 0; i < palabra.length; i++) {
                        if (grid[row][col + i] !== "" && grid[row][col + i] !== palabra[i]) {
                            fits = false;
                            break;
                        }
                    }

                    if (!fits) continue;

                    // Colocar
                    for (let i = 0; i < palabra.length; i++) {
                        grid[row][col + i] = palabra[i];
                    }
                    placed = true;
                }
            });

            // Rellenar espacios vacíos
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            for (let i = 0; i < gridSize; i++) {
                for (let j = 0; j < gridSize; j++) {
                    if (grid[i][j] === "") {
                        grid[i][j] = letters[Math.floor(Math.random() * letters.length)];
                    }
                }
            }

            // Renderizar al abrir el modal
            document.getElementById("modalSopa").addEventListener("shown.bs.modal", () => {
                const container = document.getElementById("sopaContainer");
                container.innerHTML = "";

                grid.forEach(row => {
                    row.forEach(letter => {
                        const cell = document.createElement("div");
                        cell.classList =
                            "w-8 h-8 flex items-center justify-center bg-gray-100 dark:bg-gray-700 rounded";
                        cell.textContent = letter;
                        container.appendChild(cell);
                    });
                });
            });

        });
    </script>

    <!-- Bootstrap JS for Modals (if not already included in Layout) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}
