@model AprendeTEA_19032025.Models.Unidad

@{
    ViewData["Title"] = "Detalle de Unidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? idUsuario = ViewBag.IdUsuario as int?;
}

<div class="container my-5" style="max-width: 900px;">
    <div class="form-container p-4 p-md-5">

        <div class="mb-4">
            <a asp-action="Index" asp-controller="Unidad" asp-route-IdPlanTrabajo="@Model.IdPlanTrabajo"
               class="link-back">
                <i data-lucide="arrow-left" style="width: 20px; height: 20px;" class="me-2"></i>
                Volver a las Unidades
            </a>
        </div>

        <header class="pb-3 border-bottom border-secondary border-opacity-25 mb-5">
            <h1 class="display-5 fw-bold neuropro-title mb-2">
                @Model.NombreUnidad
            </h1>
            <p class="h5 text-adaptive-inverse fw-medium">
                @Model.Detalle
            </p>
        </header>

        <div id="course-steps-container" class="d-flex flex-column gap-5">

            <div id="step-content" class="d-flex flex-column gap-4">

                <div class="welcome-section p-4 rounded-3 shadow-sm">
                    <div class="d-flex flex-column flex-md-row align-items-center gap-4">
                        <div class="flex-shrink-0 align-self-center">
                            <img src="~/img/latimente.png"
                                 alt="Latimente"
                                 style="width: 150px; height: 150px; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.15));"
                                 onerror="this.style.display='none';" />
                        </div>
                        <div class="flex-grow-1 text-center text-md-start">
                            <h3 class="h3 fw-bold text-alef-primary mb-2">
                                ¡Hola! Soy Latimente 👋
                            </h3>
                            <p class="text-body-custom fs-5 fw-light m-0">
                                Estoy muy feliz de acompañarte en esta aventura de aprendizaje. Juntos exploraremos conceptos fascinantes de una manera divertida e interactiva. ¡Recuerda que cada mente es única y especial!
                            </p>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 rounded-3">
                    <h3 class="h5 fw-bold text-body-custom mb-3 d-flex align-items-center">
                        <i data-lucide="info" class="text-alef-primary me-2" style="width: 24px; height: 24px;"></i>
                        Información General
                    </h3>
                    <div class="row">
                        <div class="col-sm-6">
                            <p class="small text-muted-custom mb-1">Fecha de Registro</p>
                            <p class="fw-bold text-body-custom m-0">@Model.FechaRegistro?.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>

                <div class="card-bg p-4 rounded-3 border border-alef-primary border-opacity-25 shadow-sm">
                    <h4 class="h5 fw-bold text-alef-teal mb-3 d-flex align-items-center">
                        <i data-lucide="lightbulb" class="me-2" style="width: 20px; height: 20px;"></i>
                        Concepto Central
                    </h4>
                    <p class="text-body-custom lh-base m-0">
                        @Model.Detalle
                    </p>
                </div>

                <div class="p-4 rounded-3 border border-secondary border-opacity-10"
                     style="background: linear-gradient(to bottom right, rgba(114, 155, 255, 0.05), rgba(227, 136, 136, 0.05));">

                    <h3 class="h4 fw-bold text-adaptive mb-3 d-flex align-items-center">
                        <i data-lucide="gamepad-2" class="me-2" style="width: 24px; height: 24px;"></i>
                        Neuro-Actividades
                    </h3>
                    <p class="text-muted-custom mb-4">Practica y afianza los conceptos de esta unidad de una forma divertida.</p>

                    <div class="row g-3">
                        @if (Model.TieneSopaLetras)
                        {
                            <div class="col-md-6">
                                <a asp-action="SopaLetras" asp-controller="Unidad" 
                                   asp-route-IdUnidad="@Model.IdUnidad" 
                                   asp-route-IdUsuario="@idUsuario"
                                   class="text-decoration-none">
                                    <div class="activity-card p-3 rounded-3 shadow-sm border-l-blue card-bg h-100 transition-transform hover-scale">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box blue me-3">
                                                    <i data-lucide="grid-3x3" style="width: 24px; height: 24px;"></i>
                                                </div>
                                                <div>
                                                    <p class="fw-bold text-body-custom m-0">Sopa de Letras</p>
                                                    <p class="small text-muted-custom m-0">Encuentra las palabras</p>
                                                </div>
                                            </div>
                                            <i data-lucide="chevron-right" class="text-muted-custom" style="width: 20px; height: 20px;"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }

                        @if (Model.TieneAgrupacion)
                        {
                            <div class="col-md-6">
                                <a asp-action="Agrupacion" asp-controller="Unidad" 
                                   asp-route-IdUnidad="@Model.IdUnidad" 
                                   asp-route-IdUsuario="@idUsuario"
                                   class="text-decoration-none">
                                    <div class="activity-card p-3 rounded-3 shadow-sm border-l-green card-bg h-100 transition-transform hover-scale">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box green me-3">
                                                    <i data-lucide="boxes" style="width: 24px; height: 24px;"></i>
                                                </div>
                                                <div>
                                                    <p class="fw-bold text-body-custom m-0">Agrupación</p>
                                                    <p class="small text-muted-custom m-0">Clasifica los elementos</p>
                                                </div>
                                            </div>
                                            <i data-lucide="chevron-right" class="text-muted-custom" style="width: 20px; height: 20px;"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }

                        @if (Model.TieneRelacionar)
                        {
                            <div class="col-md-6">
                                <a asp-action="Relacionar" asp-controller="Unidad" 
                                   asp-route-IdUnidad="@Model.IdUnidad" 
                                   asp-route-IdUsuario="@idUsuario"
                                   class="text-decoration-none">
                                    <div class="activity-card p-3 rounded-3 shadow-sm border-l-violet card-bg h-100 transition-transform hover-scale">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box violet me-3">
                                                    <i data-lucide="link" style="width: 24px; height: 24px;"></i>
                                                </div>
                                                <div>
                                                    <p class="fw-bold text-body-custom m-0">Relación de Conceptos</p>
                                                    <p class="small text-muted-custom m-0">Une las parejas correctas</p>
                                                </div>
                                            </div>
                                            <i data-lucide="chevron-right" class="text-muted-custom" style="width: 20px; height: 20px;"></i>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }

                        @if (!Model.TieneSopaLetras && !Model.TieneRelacionar && !Model.TieneAgrupacion)
                        {
                            <div class="col-12 text-center py-4">
                                <i data-lucide="inbox" class="text-muted-custom opacity-50 mb-2" style="width: 48px; height: 48px;"></i>
                                <p class="text-muted-custom fst-italic">No hay actividades configuradas para esta unidad.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
    <style>
        .hover-scale:hover {
            transform: translateY(-5px);
            transition: transform 0.2s ease;
        }
    </style>
}
