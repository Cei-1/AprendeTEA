@model AprendeTEA_19032025.Models.Unidad

@{
    ViewData["Title"] = "Detalle de Unidad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="max-w-4xl mx-auto mt-6 md:mt-10 mb-12 md:mb-16">
    <div class="bg-white dark:bg-gray-800 p-4 sm:p-6 md:p-10 rounded-xl shadow-2xl">
        
        <!-- Botón de regreso -->
        <a asp-action="Index" asp-controller="Unidad" asp-route-IdPlanTrabajo="@Model.IdPlanTrabajo"
           class="mb-6 flex items-center text-alef-primary hover:text-alef-secondary transition duration-200 font-semibold inline-block">
            <i data-lucide="arrow-left" class="w-5 h-5 mr-2 inline"></i>
            Volver a las Unidades
        </a>

        <header class="pb-4 border-b border-alef-primary/20 dark:border-alef-primary/50 mb-6">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold neuropro-title">
                @Model.NombreUnidad
            </h1>
            <p class="text-lg sm:text-xl text-alef-secondary dark:text-alef-primary font-medium mt-2">
                @Model.Detalle
            </p>
        </header>

        <!-- Contenedor de Etapas -->
        <div id="course-steps-container" class="space-y-6 md:space-y-8">
            
            <!-- 1. Etapa de Bienvenida/Contenido -->
            <div id="step-content" class="step-view space-y-4 md:space-y-6">
                <!-- Welcome Section with Mascot -->
                <div class="welcome-section p-4 sm:p-6 rounded-xl">
                    <div class="flex flex-col md:flex-row items-start md:space-x-6 gap-4 md:gap-0">
                        <div class="mb-4 md:mb-0">
                            <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-32 md:h-32 bg-gradient-to-br from-alef-primary to-alef-secondary rounded-full flex items-center justify-center">
                                <i data-lucide="sparkles" class="w-10 h-10 sm:w-12 sm:h-12 md:w-16 md:h-16 text-white"></i>
                            </div>
                        </div>
                        <div class="flex-grow">
                            <h3 class="text-xl sm:text-2xl font-bold text-alef-primary dark:text-alef-secondary mb-2">
                                ¡Bienvenido a esta Unidad!
                            </h3>
                            <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-base sm:text-lg font-light">
                                Explora el fascinante mundo de esta unidad está diseñada para potenciar tus habilidades y conocimientos de manera interactiva y divertida.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Información General -->
                <div class="glass-card p-4 sm:p-6 rounded-xl">
                    <h3 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-4 flex items-center">
                        <i data-lucide="info" class="w-6 h-6 mr-2 text-alef-primary"></i>
                        Información General
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Fecha de Registro</p>
                            <p class="font-semibold text-gray-800 dark:text-gray-200">@Model.FechaRegistro?.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>

                <!-- Concepto Central -->
                <div class="bg-white dark:bg-gray-800 p-4 sm:p-6 rounded-xl border-2 border-alef-primary/20 dark:border-alef-secondary/20 shadow-md">
                    <h4 class="text-xl font-semibold text-alef-teal-base dark:text-alef-green-base mb-3 flex items-center">
                        <i data-lucide="lightbulb" class="w-5 h-5 mr-2"></i>
                        Concepto Central
                    </h4>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                        @Model.Detalle
                    </p>
                </div>

                <!-- Actividades Interactivas -->
                <div class="bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-800 dark:to-gray-700 p-4 sm:p-6 rounded-xl border border-gray-200 dark:border-gray-600">
                    <h3 class="text-xl sm:text-2xl font-bold text-alef-primary dark:text-alef-secondary mb-4 flex items-center">
                        <i data-lucide="gamepad-2" class="w-6 h-6 mr-2"></i>
                        Neuro-Actividades
                    </h3>
                    <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 mb-4 md:mb-6">Practica y afianza los conceptos de esta unidad de una forma divertida.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
                        @if (Model.TieneSopaLetras)
                        {
                            <div class="activity-card p-3 sm:p-4 bg-white dark:bg-gray-800 rounded-xl shadow-md border-l-4 border-blue-500" data-bs-toggle="modal" data-bs-target="#modalSopa">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-3">
                                            <i data-lucide="grid-3x3" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-gray-800 dark:text-gray-200">Sopa de Letras</p>
                                            <p class="text-sm text-gray-500 dark:text-gray-400">Encuentra las palabras</p>
                                        </div>
                                    </div>
                                    <i data-lucide="chevron-right" class="w-5 h-5 text-gray-400"></i>
                                </div>
                            </div>
                        }
                        @if (Model.TieneCrucigrama)
                        {
                            <div class="activity-card p-3 sm:p-4 bg-white dark:bg-gray-800 rounded-xl shadow-md border-l-4 border-green-500" data-bs-toggle="modal" data-bs-target="#modalCrucigrama">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mr-3">
                                            <i data-lucide="puzzle" class="w-6 h-6 text-green-600 dark:text-green-400"></i>
                                        </div>
                                        <div>
                                            <p class="font-bold text-gray-800 dark:text-gray-200">Crucigrama</p>
                                            <p class="text-sm text-gray-500 dark:text-gray-400">Resuelve el desafío</p>
                                        </div>
                                    </div>
                                    <i data-lucide="chevron-right" class="w-5 h-5 text-gray-400"></i>
                                </div>
                            </div>
                        }
                        
                        @if (!Model.TieneSopaLetras && !Model.TieneCrucigrama && !Model.TieneRelacionar && !Model.TieneMemorama && !Model.TieneJuegoRol)
                        {
                            <div class="col-span-2 text-center py-8">
                                <i data-lucide="inbox" class="w-12 h-12 mx-auto text-gray-400 mb-3"></i>
                                <p class="text-gray-500 dark:text-gray-400 italic">No hay actividades configuradas para esta unidad.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Botón de Navegación -->
            <div id="course-navigation-bar" class="flex justify-end pt-4 border-t border-gray-100 dark:border-gray-700">

            </div>
        </div>
    </div>
</div>

<!-- Modales -->
<!-- Sopa de Letras -->
<div class="modal fade" id="modalSopa" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-lg" style="z-index: 10000;">
        <div class="modal-content dark:bg-gray-800 dark:text-white">
            <div class="modal-header border-b dark:border-gray-700">
                <h5 class="modal-title font-bold">Sopa de Letras</h5>
                <button type="button" class="btn-close dark:filter dark:invert" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <!-- Contenedor visual de la sopa -->
                <div id="sopaContainer" class="grid gap-1 text-center font-bold text-sm sm:text-base md:text-lg mb-4" style="grid-template-columns: repeat(auto-fit, minmax(1.5rem, 1fr));">
                    <!-- Aquí se genera automáticamente -->
                </div>
            </div>
        </div>
    </div>
</div>

