@model AprendeTEA_19032025.Models.Unidad
@using System.Security.Claims

@{
    ViewData["Title"] = $"Sopa de Letras";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? idUsuario = ViewBag.IdUsuario as int?;
    
    // Detectar rol para redirección
    var esAdmin = User.IsInRole("Admin");
}

<style>
    .sopa-wrapper {
        padding: 10px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .sopa-title {
        color: #1e293b;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }
    [data-bs-theme="dark"] .sopa-title {
        color: #f1f5f9;
    }
    /* Responsive adjustments */
    @@media (min-width: 768px) {
        .sopa-wrapper {
            padding: 40px;
            max-width: 900px;
        }
        .sopa-title {
            font-size: 2rem;
        }
    }
    #timer {
        margin-top: 10px;
        font-size: 18px;
        font-weight: bold;
        color: var(--alef-purple);
    }
    #wordList {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px 12px;
        max-width: 100%;
        padding: 0 10px;
        margin-top: 20px;
        display: none;
    }
    @@media (min-width: 768px) {
        #wordList {
            gap: 10px 20px;
            max-width: 600px;
            padding: 0;
        }
    }
    .word {
        padding: 5px 10px;
        background-color: #334155;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
        color: white;
        transition: all 0.3s ease;
    }
    @@media (min-width: 768px) {
        .word {
            padding: 6px 12px;
            font-size: 16px;
        }
    }
    .word.found {
        text-decoration: line-through;
        color: white;
        background-color: #10b981;
    }
    #grid {
        display: inline-grid;
        grid-template-columns: repeat(8, 30px);
        gap: 3px;
        margin: 20px 0 0;
        background: #f8fafc;
        padding: 1rem;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }
    /* Dark mode grid background */
    [data-bs-theme="dark"] #grid {
        background: #0f172a;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.5);
        border: 1px solid #334155;
    }
    /* Responsive grid */
    @@media (min-width: 480px) {
        #grid {
            grid-template-columns: repeat(10, 35px);
            gap: 4px;
            padding: 1.25rem;
        }
    }
    @@media (min-width: 768px) {
        #grid {
            grid-template-columns: repeat(12, 40px);
            gap: 5px;
            margin-top: 30px;
            padding: 1.5rem;
        }
    }
    .cell {
        width: 30px;
        height: 30px;
        background: #e2e8f0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        font-size: 14px;
        cursor: pointer;
        user-select: none;
        border-radius: 6px;
        transition: all 0.2s ease;
        color: #1e293b;
    }
    @@media (min-width: 480px) {
        .cell {
            width: 35px;
            height: 35px;
            font-size: 16px;
        }
    }
    @@media (min-width: 768px) {
        .cell {
            width: 40px;
            height: 40px;
            font-size: 18px;
        }
    }
    /* Dark mode support */
    [data-bs-theme="dark"] .cell {
        background: #334155;
        color: #f1f5f9;
        border: 1px solid #475569;
    }
    [data-bs-theme="dark"] .cell:hover {
        background: #475569;
    }
    .selected {
        background-color: #38bdf8 !important;
        color: white !important;
    }
    [data-bs-theme="dark"] .selected {
        background-color: #0ea5e9 !important;
        color: white !important;
    }
    /* Colores para palabras encontradas */
    .found { color: white !important; }
    .found1 { background-color: #10b981 !important; }
    .found2 { background-color: #facc15 !important; }
    .found3 { background-color: #f472b6 !important; }
    .found4 { background-color: #60a5fa !important; }
    .found5 { background-color: #a78bfa !important; }
    .found6 { background-color: #fb923c !important; }
    .found7 { background-color: #ec4899 !important; }
    .found8 { background-color: #34d399 !important; }
    .found9 { background-color: #e879f9 !important; }
    .found10 { background-color: #f87171 !important; }
    #modalVictory {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    #modalContent {
        background: white;
        padding: 30px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        max-width: 400px;
        width: 90%;
        color: #1e293b; /* Texto oscuro para asegurar visibilidad */
    }
    
    #modalContent h2,
    #modalContent p {
        color: #1e293b !important;
    }
</style>
<!-- Neuro Pro Header -->
<div class="mb-4 mb-md-5 d-flex flex-column align-items-center pt-4">
    <div class="hero-title-container mb-3 d-flex align-items-center gap-2 gap-md-3">
        <img src="~/img/logo.png"
             alt="Logo Neuro Pro"
             class="hero-logo"
             style="width: 3rem; height: 3rem; object-fit: contain;"
             onerror="this.style.display='none';" />
        <h2 class="display-5 display-md-4 m-0 fw-bold text-adaptive">
            NEURO PRO
        </h2>
    </div>
    <h3 class="h5 h4-md fw-semibold text-adaptive-inverse text-center px-3" style="max-width: 600px;">
        Rutas de Consciencia y Neurodiversidad
    </h3>
</div>
<!-- Sopa de Letras Content -->
<div class="sopa-wrapper text-center">
    <h2 class="sopa-title fw-bold text-adaptive">Sopa de Letras</h2>
    <div id="timer"></div>
    <div id="wordList"></div>
    <div id="grid"></div>
</div>
<!-- Modal Victoria -->
<div id="modalVictory">
    <div id="modalContent">
        <h2 class="text-success mb-3">🎉 ¡Felicidades!</h2>
        <p class="fs-5">¡Has encontrado todas las palabras!</p>
        <p id="timeTaken" class="fw-bold fs-4 my-3"></p>
        <div id="savingMessage" class="text-muted small" style="display:none;">Guardando progreso...</div>
        <button id="btnContinuar" class="btn btn-primary mt-3" style="display:none;">Continuar</button>
    </div>
</div>
<script>
    // Función para quitar acentos
    function removeAccents(str) {
        return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    }
    // Obtener palabras del modelo
    const rawWords = "@(Model.PalabrasSopa ?? "")";
    let allWords = rawWords ? rawWords.split(',').map(w => removeAccents(w.trim().toUpperCase())).filter(w => w) : ["EJEMPLO"];
    
    // Limitar a 6 palabras máximo
    let words = allWords.slice(0, 6);
    
    // Si no hay palabras válidas, usar fallback
    if(words.length === 0) words = ["GENERICO", "PRUEBA"];
    // Configuración del tamaño del grid según el viewport (cols x rows)
    // Móvil: 8 columnas x 14 filas (vertical)
    // Tablet: 10 x 10 (cuadrado)
    // Desktop: 12 x 12 (cuadrado)
    let gridCols = window.innerWidth < 480 ? 8 : (window.innerWidth < 768 ? 10 : 12);
    let gridRows = window.innerWidth < 480 ? 14 : (window.innerWidth < 768 ? 10 : 12);
    const grid = document.getElementById("grid");
    const wordList = document.getElementById("wordList");
    const modalVictory = document.getElementById("modalVictory");
    const timeTakenText = document.getElementById("timeTaken");
    const timerDisplay = document.getElementById("timer");
    const savingMessage = document.getElementById("savingMessage");
    const btnContinuar = document.getElementById("btnContinuar");
    let cells = [], foundWords = [];
    let isDragging = false, dragPath = [];
    let startTime, intervalId;
    let totalSecondsElapsed = 0;
    const idUsuario = @(idUsuario.HasValue ? idUsuario.Value : "null");
    const idUnidad = @Model.IdUnidad;
    const idPlanTrabajo = @Model.IdPlanTrabajo;
    
    // URL de retorno basada en rol del usuario
    const esAdmin = @(esAdmin ? "true" : "false");
    const returnURL = esAdmin 
        ? `/Unidad/Index?IdPlanTrabajo=${idPlanTrabajo}` 
        : `/Unidad/ProgresoUnidades?IdPlanTrabajo=${idPlanTrabajo}`;
    function formatTime(ms) {
        const totalSeconds = Math.floor(ms / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}m ${seconds}s`;
    }
    function startTimer() {
        startTime = Date.now();
        intervalId = setInterval(() => {
            const elapsed = Date.now() - startTime;
            timerDisplay.textContent = `⏱ Tiempo: ${formatTime(elapsed)}`;
        }, 1000);
    }
    function stopTimer() {
        clearInterval(intervalId);
        const elapsed = Date.now() - startTime;
        totalSecondsElapsed = Math.floor(elapsed / 1000); // Para guardar en BD si se requiere segundos
        timeTakenText.textContent = `Tiempo total: ${formatTime(elapsed)}`;
        
        // Finalizar y Guardar
        onFinishActivity(totalSecondsElapsed);
    }
    function onFinishActivity(seconds) {
        modalVictory.style.display = "flex";
        
        // Calcular calificación basada en tiempo (escala de 0-10)
        let calificacion = 10;
        if (seconds <= 30) {
            calificacion = 10;
        } else if (seconds <= 60) {
            calificacion = 9;
        } else if (seconds <= 90) {
            calificacion = 8;
        } else if (seconds <= 120) {
            calificacion = 7;
        } else if (seconds <= 180) {
            calificacion = 6;
        } else if (seconds <= 240) {
            calificacion = 5;
        } else if (seconds <= 300) {
            calificacion = 4;
        } else if (seconds <= 360) {
            calificacion = 3;
        } else if (seconds <= 420) {
            calificacion = 2;
        } else if (seconds <= 480) {
            calificacion = 1;
        } else {
            calificacion = 0;
        }
        
        if (idUsuario) {
            // Guardar calificación
            savingMessage.style.display = "block";
            
            fetch('/Unidad/GuardarCalificacion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    IdUsuario: idUsuario,
                    IdUnidad: idUnidad,
                    Calificacion: calificacion,
                    TiempoDedicado: (seconds / 60) // Guardar en minutos decimales
                })
            })
            .then(response => response.json())
            .then(data => {
                savingMessage.style.display = "none";
                if(data.success) {
                    btnContinuar.textContent = "Continuar";
                    btnContinuar.onclick = () => window.location.href = returnURL;
                } else {
                    btnContinuar.textContent = "Error al guardar (Continuar)";
                    btnContinuar.onclick = () => window.location.href = returnURL;
                }
                btnContinuar.style.display = "inline-block";
                
                // Redirección automática después de 3 segundos
                 setTimeout(() => {
                     window.location.href = returnURL; 
                 }, 3000);
            })
            .catch(err => {
                console.error(err);
                savingMessage.textContent = "Error de conexión.";
                btnContinuar.style.display = "inline-block";
                btnContinuar.onclick = () => window.location.href = returnURL;
                // Redirect anyway
                setTimeout(() => { window.location.href = returnURL; }, 3000);
            });
        } else {
            // Sin usuario, solo mostrar botón para volver
            btnContinuar.style.display = "inline-block";
            btnContinuar.onclick = () => window.location.href = returnURL;
        }
    }
    function renderWordList() {
        wordList.innerHTML = "";
        words.forEach((word) => {
            const span = document.createElement("span");
            span.className = "word";
            span.id = `word-${word}`;
            span.textContent = word;
            wordList.appendChild(span);
        });
    }
    function createGrid() {
        grid.innerHTML = "";
        cells = [];
        // Ajustar grid CSS dinámicamente
        const cellSize = window.innerWidth < 480 ? 30 : (window.innerWidth < 768 ? 35 : 40);
        grid.style.gridTemplateColumns = `repeat(${gridCols}, ${cellSize}px)`;
        
        for (let y = 0; y < gridRows; y++) {
            for (let x = 0; x < gridCols; x++) {
                const div = document.createElement("div");
                div.classList.add("cell");
                // Letra aleatoria temporal
                div.textContent = ""; 
                div.dataset.x = x;
                div.dataset.y = y;
                grid.appendChild(div);
                cells.push(div);
            }
        }
    }
    function getCell(x, y) {
        return cells.find(cell => parseInt(cell.dataset.x) === x && parseInt(cell.dataset.y) === y);
    }
    function placeWords() {
        // Limpiar grid lógico
        cells.forEach(c => {
             c.textContent = ""; 
             delete c.dataset.locked;
             delete c.dataset.word;
        });
        words.forEach(word => {
            let placed = false, attempts = 0;
            while (!placed && attempts < 500) { // Aumentar intentos
                attempts++;
                // Solo horizontal (0) o vertical (1), NO diagonal
                const dir = Math.floor(Math.random() * 2); 
                
                let startX, startY;
                
                // Rango seguro según dirección y longitud
                if (dir === 0) { // Horizontal
                    startX = Math.floor(Math.random() * Math.max(1, gridCols - word.length + 1));
                    startY = Math.floor(Math.random() * gridRows);
                } else { // Vertical
                    startX = Math.floor(Math.random() * gridCols);
                    startY = Math.floor(Math.random() * Math.max(1, gridRows - word.length + 1));
                }
                let canPlace = true;
                const positions = [];
                for (let i = 0; i < word.length; i++) {
                    const x = startX + (dir === 0 ? i : 0);
                    const y = startY + (dir === 1 ? i : 0);
                    const cell = getCell(x, y);
                    
                    if (!cell) {
                        canPlace = false;
                        break;
                    }
                    // Permitir si la celda está vacía O tiene la misma letra
                    if (cell.textContent && cell.textContent !== word[i]) {
                        canPlace = false;
                        break;
                    }
                    positions.push({x, y, letter: word[i]});
                }
                if (canPlace) {
                    positions.forEach(({x, y, letter}) => {
                        const cell = getCell(x, y);
                        cell.textContent = letter;
                        cell.dataset.locked = "true";
                        if (!cell.dataset.word) cell.dataset.word = "";
                        cell.dataset.word += word + ";";
                    });
                    placed = true;
                }
            }
        });
        // Rellenar celdas vacías con letras aleatorias
        cells.forEach(c => {
            if (!c.textContent) {
                c.textContent = String.fromCharCode(65 + Math.floor(Math.random() * 26));
            }
        });
    }
    // Drag handlers
    grid.addEventListener("mousedown", e => {
        if (e.target.classList.contains("cell")) {
            isDragging = true;
            dragPath = [e.target];
            e.target.classList.add("selected");
        }
    });
    grid.addEventListener("mouseover", e => {
        if (isDragging && e.target.classList.contains("cell") && !dragPath.includes(e.target)) {
            dragPath.push(e.target);
            e.target.classList.add("selected");
        }
    });
    document.addEventListener("mouseup", () => {
        if (isDragging) {
            checkWord();
            clearSelection();
            isDragging = false;
        }
    });
    // Touch handlers
    grid.addEventListener("touchstart", e => {
        e.preventDefault();
        const touch = e.touches[0];
        const target = document.elementFromPoint(touch.clientX, touch.clientY);
        if (target && target.classList.contains("cell")) {
            isDragging = true;
            dragPath = [target];
            target.classList.add("selected");
        }
    });
    grid.addEventListener("touchmove", e => {
        e.preventDefault();
        if (isDragging) {
            const touch = e.touches[0];
            const target = document.elementFromPoint(touch.clientX, touch.clientY);
            if (target && target.classList.contains("cell") && !dragPath.includes(target)) {
                dragPath.push(target);
                target.classList.add("selected");
            }
        }
    });
    document.addEventListener("touchend", e => {
        if (isDragging) {
            checkWord();
            clearSelection();
            isDragging = false;
        }
    });
    function checkWord() {
        if (dragPath.length === 0) return;
        const selectedWord = dragPath.map(c => c.textContent).join("");
        const reversedWord = selectedWord.split("").reverse().join("");
        let matchedWord = null;
        if (words.includes(selectedWord) && !foundWords.includes(selectedWord)) {
            matchedWord = selectedWord;
        } else if (words.includes(reversedWord) && !foundWords.includes(reversedWord)) {
            matchedWord = reversedWord;
        }
        if (matchedWord) {
            foundWords.push(matchedWord);
            const colorClass = `found${foundWords.length}`;
            dragPath.forEach(c => {
                c.classList.add("found");
                c.classList.add(colorClass);
            });
            // Marcar palabra como encontrada en la lista
            const wordSpan = document.getElementById(`word-${matchedWord}`);
            if (wordSpan) wordSpan.classList.add("found");
            if (foundWords.length === words.length) {
                stopTimer();
            }
        }
    }
    function clearSelection() {
        cells.forEach(c => c.classList.remove("selected"));
        dragPath = [];
    }
    // Iniciar juego
    renderWordList();
    createGrid();
    placeWords();
    grid.style.display = "inline-grid";
    wordList.style.display = "flex";
    startTimer();
</script>
