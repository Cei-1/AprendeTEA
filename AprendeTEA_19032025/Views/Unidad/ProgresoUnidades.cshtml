@model AprendeTEA_19032025.Models.UnidadProgreso

@{
    ViewData["Title"] = "Mi Progreso en Unidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="responsive-container my-4 my-md-5 px-2 px-md-3">
    <div class="form-container">

        <div class="mb-4">
            <a asp-action="Progreso" asp-controller="PlanTrabajo" class="link-back">
                <i data-lucide="arrow-left" style="width: 20px; height: 20px;" class="me-2"></i>
                Volver al Progreso
            </a>
        </div>

        <h1 class="h2 fw-bold neuropro-title mb-2 text-center">
            Plan de Trabajo #@ViewBag.IdPlanTrabajo
        </h1>
        <p class="lead text-center text-body-custom mb-4">
            Mi Progreso en Unidades de Aprendizaje
        </p>

        <div>
            <h2 class="h4 fw-bold text-alef-primary mb-4 d-flex align-items-center">
                <i data-lucide="layers" style="width: 24px; height: 24px;" class="me-2 text-alef-secondary"></i>
                Unidades de Aprendizaje
            </h2>

            <div id="modules-container" class="d-flex flex-column gap-3">
                @if (Model.Unidades != null && Model.Unidades.Any())
                {
                    int index = 1;
                    foreach (var unidad in Model.Unidades)
                    {
                        <div class="module-card p-3 p-md-4 rounded-3 shadow-sm d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3">

                            <div class="d-flex align-items-center flex-grow-1 w-100">
                                <span class="index-number me-3 text-nowrap">@(index++).</span>

                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <p class="h5 fw-bold text-body-custom m-0">@unidad.Unidad</p>
                                        @if (unidad.Completada)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.7rem;">Completada</span>
                                        }
                                    </div>
                                    <p class="small text-muted-custom m-0">
                                        <span class="fw-bold">Fecha de Registro:</span> @unidad.FechaRegistro?.ToString("dd/MM/yyyy")
                                    </p>
                                </div>
                            </div>

                            <div class="w-100 w-md-auto d-flex">
                                <a asp-action="DetalleUnidad" asp-controller="Unidad" 
                                   asp-route-IdUnidad="@unidad.IdUnidad"
                                   asp-route-IdUsuario="@ViewBag.IdUsuario"
                                   class="btn-alef-submit py-2 px-4 d-flex align-items-center justify-content-center w-100 text-decoration-none shadow-sm"
                                   style="font-size: 0.9rem;">
                                    <i data-lucide="eye" style="width: 16px; height: 16px;" class="me-2"></i>
                                    Ver Detalle
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state-box">
                        <i data-lucide="inbox" style="width: 64px; height: 64px;" class="text-muted-custom opacity-50 mb-3"></i>
                        <p class="fs-5 text-muted-custom fw-bold mb-1">No hay unidades disponibles para este plan.</p>
                        <p class="small text-muted-custom opacity-75">Comunícate con tu administrador.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}
