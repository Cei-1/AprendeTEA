@model AprendeTEA_19032025.Models.Unidad
@using System.Security.Claims

@{
    ViewData["Title"] = "Relacionar Conceptos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? idUsuario = ViewBag.IdUsuario as int?;
    var esAdmin = User.IsInRole("Admin");
}

<style>
    /* Wrapper principal */
    .relacionar-wrapper {
        padding: 8px;
        margin: 0 auto;
        max-width: 100%;
    }
    
    @@media (min-width: 768px) {
        .relacionar-wrapper {
            padding: 30px;
            max-width: 1200px;
        }
    }
    
    /* Título */
    .relacionar-title {
        color: #1e293b;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
        text-align: center;
    }
    
    body.dark-mode .relacionar-title {
        color: #f1f5f9;
    }
    
    @@media (min-width: 768px) {
        .relacionar-title {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
    }
    
    /* Instrucciones */
    .instructions-box {
        background: linear-gradient(135deg, rgba(114, 155, 255, 0.1), rgba(227, 136, 136, 0.1));
        border-left: 4px solid #729bff;
        padding: 0.75rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        text-align: center;
    }
    
    body.dark-mode .instructions-box {
        background: linear-gradient(135deg, rgba(114, 155, 255, 0.2), rgba(227, 136, 136, 0.2));
        border-left-color: #e38888;
    }
    
    @@media (min-width: 768px) {
        .instructions-box {
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
    }
    
    .instructions-text {
        font-size: 0.875rem;
        color: #475569;
        margin: 0;
    }
    
    body.dark-mode .instructions-text {
        color: #cbd5e1;
    }
    
    @@media (min-width: 768px) {
        .instructions-text {
            font-size: 1rem;
        }
    }
    
    /* Stats container */
    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }
    
    @@media (min-width: 768px) {
        .stats-grid {
            gap: 1rem;
            margin-bottom: 1.5rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
    }
    
    .stat-card {
        background: white;
        padding: 0.75rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #e2e8f0;
    }
    
    body.dark-mode .stat-card {
        background: #0f172a;
        box-shadow: 0 2px 8px rgba(0,0,0,0.5);
        border-color: #334155;
    }
    
    @@media (min-width: 768px) {
        .stat-card {
            padding: 1rem;
        }
    }
    
    .stat-label {
        font-size: 0.65rem;
        color: #64748b;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    body.dark-mode .stat-label {
        color: #94a3b8;
    }
    
    @@media (min-width: 768px) {
        .stat-label {
            font-size: 0.875rem;
        }
    }
    
    .stat-value {
        font-size: 1.25rem;
        font-weight: bold;
        color: #729bff;
    }
    
    body.dark-mode .stat-value {
        color: #93b5ff;
    }
    
    @@media (min-width: 768px) {
        .stat-value {
            font-size: 2rem;
        }
    }
    
    .stat-value.success {
        color: #10b981;
    }
    
    body.dark-mode .stat-value.success {
        color: #34d399;
    }
    
    .stat-value.error {
        color: #ef4444;
    }
    
    body.dark-mode .stat-value.error {
        color: #f87171;
    }
    
    /* Game Container */
    .game-area {
        background: white;
        border-radius: 16px;
        padding: 0.75rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        margin-bottom: 1rem;
        position: relative;
        border: 1px solid #e2e8f0;
    }
    
    body.dark-mode .game-area {
        background: #0f172a;
        box-shadow: 0 4px 16px rgba(0,0,0,0.5);
        border-color: #1e293b;
    }
    
    @@media (min-width: 768px) {
        .game-area {
            padding: 2rem;
            margin-bottom: 1.5rem;
        }
    }
    
    /* Columns - Lado a lado desde 576px (tablet) */
    .columns-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
    }
    
    @@media (min-width: 576px) {
        .columns-container {
            flex-direction: row;
            gap: 1.5rem;
            justify-content: space-between;
            align-items: flex-start;
        }
    }
    
    @@media (min-width: 768px) {
        .columns-container {
            gap: 3rem;
        }
    }
    
    .concept-column, .definition-column {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        max-width: 100%;
        width: 100%;
    }
    
    @@media (min-width: 576px) {
        .concept-column, .definition-column {
            max-width: 48%;
            gap: 0.75rem;
        }
    }
    
    .column-header {
        font-size: 1rem;
        font-weight: bold;
        color: #729bff;
        margin-bottom: 0.5rem;
        text-align: center;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
    }
    
    body.dark-mode .column-header {
        color: #e38888;
        border-bottom-color: #334155;
    }
    
    @@media (min-width: 768px) {
        .column-header {
            font-size: 1.125rem;
        }
    }
    
    /* Items */
    .match-item {
        background: #f8fafc;
        border: 2px solid #cbd5e1;
        border-radius: 12px;
        padding: 0.75rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        user-select: none;
        position: relative;
        min-height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        line-height: 1.4;
        color: #1e293b;
    }
    
    body.dark-mode .match-item {
        background: #1e293b;
        border-color: #475569;
        color: #f1f5f9;
    }
    
    @@media (min-width: 768px) {
        .match-item {
            padding: 1rem;
            min-height: 60px;
            font-size: 0.95rem;
        }
    }
    
    .match-item:hover:not(.matched):not(.wrong) {
        transform: translateY(-3px);
        box-shadow: 0 4px 12px rgba(114, 155, 255, 0.4);
        border-color: #729bff;
    }
    
    body.dark-mode .match-item:hover:not(.matched):not(.wrong) {
        box-shadow: 0 4px 12px rgba(114, 155, 255, 0.5);
        border-color: #93b5ff;
    }
    
    .match-item.selected {
        border-color: #729bff;
        background: rgba(114, 155, 255, 0.2);
        box-shadow: 0 0 0 3px rgba(114, 155, 255, 0.3);
    }
    
    body.dark-mode .match-item.selected {
        background: rgba(114, 155, 255, 0.25);
        border-color: #93b5ff;
        box-shadow: 0 0 0 3px rgba(114, 155, 255, 0.4);
    }
    
    /* Matched items - Glowing green border */
    .match-item.matched {
        border-color: #10b981;
        border-width: 3px;
        background: rgba(16, 185, 129, 0.15);
        pointer-events: none;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.4), 
                    0 0 40px rgba(16, 185, 129, 0.2),
                    inset 0 0 10px rgba(16, 185, 129, 0.1);
        animation: pulse-glow 2s ease-in-out infinite;
    }
    
    body.dark-mode .match-item.matched {
        border-color: #34d399;
        background: rgba(16, 185, 129, 0.2);
        box-shadow: 0 0 20px rgba(52, 211, 153, 0.5), 
                    0 0 40px rgba(52, 211, 153, 0.3),
                    inset 0 0 10px rgba(52, 211, 153, 0.15);
    }
    
    @@keyframes pulse-glow {
        0%, 100% {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.4), 
                        0 0 40px rgba(16, 185, 129, 0.2),
                        inset 0 0 10px rgba(16, 185, 129, 0.1);
        }
        50% {
            box-shadow: 0 0 30px rgba(16, 185, 129, 0.6), 
                        0 0 60px rgba(16, 185, 129, 0.3),
                        inset 0 0 15px rgba(16, 185, 129, 0.2);
        }
    }
    
    .match-item.wrong {
        border-color: #ef4444;
        background: rgba(239, 68, 68, 0.15);
        animation: shake 0.4s;
    }
    
    body.dark-mode .match-item.wrong {
        border-color: #f87171;
        background: rgba(239, 68, 68, 0.2);
    }
    
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(8px); }
    }
    
    /* Modal */
    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(5px);
    }
    
    .modal-content-custom {
        background: white;
        padding: 1.5rem;
        border-radius: 20px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        animation: modalSlideIn 0.3s ease-out;
        border: 1px solid #e2e8f0;
    }
    
    body.dark-mode .modal-content-custom {
        background: #1e293b;
        color: #f1f5f9;
        border-color: #334155;
    }
    
    @@media (min-width: 768px) {
        .modal-content-custom {
            padding: 2rem;
            max-width: 450px;
        }
    }
    
    @@keyframes modalSlideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    .modal-title {
        font-size: 1.5rem;
        color: #10b981;
        margin-bottom: 0.75rem;
    }
    
    body.dark-mode .modal-title {
        color: #34d399;
    }
    
    @@media (min-width: 768px) {
        .modal-title {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
    }
    
    .modal-score {
        font-size: 2.5rem;
        font-weight: bold;
        color: #729bff;
        margin: 0.75rem 0;
    }
    
    body.dark-mode .modal-score {
        color: #93b5ff;
    }
    
    @@media (min-width: 768px) {
        .modal-score {
            font-size: 3rem;
            margin: 1rem 0;
        }
    }
    
    .modal-text {
        color: #64748b;
        margin: 0.5rem 0;
        font-size: 0.9rem;
    }
    
    body.dark-mode .modal-text {
        color: #cbd5e1;
    }
    
    @@media (min-width: 768px) {
        .modal-text {
            font-size: 1rem;
        }
    }
</style>

<!-- Neuro Pro Header -->
<div class="mb-4 mb-md-5 d-flex flex-column align-items-center pt-4">
    <div class="hero-title-container mb-3 d-flex align-items-center gap-2 gap-md-3">
        <img src="~/img/logo.png"
             alt="Logo Neuro Pro"
             class="hero-logo"
             style="width: 3rem; height: 3rem; object-fit: contain;"
             onerror="this.style.display='none';" />
        <h2 class="display-5 display-md-4 m-0 fw-bold text-adaptive">
            NEURO PRO
        </h2>
    </div>
    <h3 class="h5 h4-md fw-semibold text-adaptive-inverse text-center px-3" style="max-width: 600px;">
        Rutas de Consciencia y Neurodiversidad
    </h3>
</div>

<!-- Relacionar Content -->
<div class="relacionar-wrapper">
    <h2 class="relacionar-title fw-bold">Relacionar Conceptos</h2>
    
    <!-- Instructions -->
    <div class="instructions-box">
        <p class="instructions-text">
            🧠 <strong>Instrucciones:</strong> Haz clic en un concepto de la izquierda, luego haz clic en su definición correcta de la derecha para emparejarlos.
        </p>
    </div>
    
    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">⏱️ Tiempo</div>
            <div class="stat-value" id="timer">00:00</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">✅ Aciertos</div>
            <div class="stat-value success" id="aciertos">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">❌ Errores</div>
            <div class="stat-value error" id="errores">0</div>
        </div>
    </div>
    
    <!-- Game Area -->
    <div class="game-area" id="gameArea">
        <div class="columns-container">
            <div class="concept-column">
                <div class="column-header">📚 Conceptos</div>
                <div id="conceptsColumn"></div>
            </div>
            <div class="definition-column">
                <div class="column-header">📖 Definiciones</div>
                <div id="definitionsColumn"></div>
            </div>
        </div>
    </div>
</div>

<!-- Victory Modal -->
<div class="modal-backdrop-custom" id="victoryModal">
    <div class="modal-content-custom">
        <h2 class="modal-title">🎉 ¡Excelente!</h2>
        <p class="modal-text">Has completado la actividad</p>
        <div class="modal-score" id="finalScore">10.0</div>
        <p class="modal-text"><strong>Tiempo:</strong> <span id="finalTime"></span></p>
        <p class="modal-text"><strong>Errores:</strong> <span id="finalErrors"></span></p>
        <p class="modal-text" id="savingMessage" style="display:none; color: #729bff; font-weight: bold;">Guardando...</p>
        <button id="btnContinuar" class="btn btn-primary mt-3" style="display:none;">Continuar</button>
    </div>
</div>

<script>
    // Datos del servidor
    const idUnidad = @Model.IdUnidad;
    const idPlanTrabajo = @Model.IdPlanTrabajo;
    const idUsuario = @(idUsuario.HasValue ? idUsuario.Value : "null");
    const esAdmin = @(esAdmin ? "true" : "false");
    const returnURL = esAdmin 
        ? `/Unidad/Index?IdPlanTrabajo=${idPlanTrabajo}` 
        : `/Unidad/ProgresoUnidades?IdPlanTrabajo=${idPlanTrabajo}`;
    
    // Parsear datos (formato: concepto:definicion;concepto2:definicion2;)
    const rawData = `@Html.Raw(Model.RelacionarColumnas ?? "")`;
    const pairs = [];
    
    console.log('Raw data:', rawData); // Debug
    
    if (rawData) {
        const items = rawData.split(';').filter(item => item.trim());
        console.log('Items after split:', items); // Debug
        
        items.forEach(item => {
            const [concept, definition] = item.split(':');
            if (concept && definition) {
                pairs.push({ 
                    id: pairs.length,
                    concept: concept.trim(), 
                    definition: definition.trim() 
                });
            }
        });
    }
    
    console.log('Total pairs parsed:', pairs.length); // Debug
    console.log('Pairs:', pairs); // Debug
    
    // Variables del juego
    let selectedConcept = null;
    let aciertos = 0;
    let errores = 0;
    let startTime = Date.now();
    let timerInterval;
    const gameArea = document.getElementById('gameArea');
    
    // Timer
    function startTimer() {
        timerInterval = setInterval(() => {
            const elapsed = Date.now() - startTime;
            const minutes = Math.floor(elapsed / 60000);
            const seconds = Math.floor((elapsed % 60000) / 1000);
            document.getElementById('timer').textContent = 
                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }, 1000);
    }
    
    function stopTimer() {
        clearInterval(timerInterval);
    }
    
    // Inicializar juego
    function initGame() {
        const conceptsCol = document.getElementById('conceptsColumn');
        const definitionsCol = document.getElementById('definitionsColumn');
        
        // Mezclar
        const shuffledConcepts = [...pairs].sort(() => Math.random() - 0.5);
        const shuffledDefinitions = [...pairs].sort(() => Math.random() - 0.5);
        
        // Crear conceptos
        shuffledConcepts.forEach(pair => {
            const div = document.createElement('div');
            div.className = 'match-item';
            div.dataset.id = pair.id;
            div.textContent = pair.concept;
            div.onclick = () => selectConcept(div, pair.id);
            conceptsCol.appendChild(div);
        });
        
        // Crear definiciones
        shuffledDefinitions.forEach(pair => {
            const div = document.createElement('div');
            div.className = 'match-item';
            div.dataset.id = pair.id;
            div.textContent = pair.definition;
            div.onclick = () => selectDefinition(div, pair.id);
            definitionsCol.appendChild(div);
        });
        
        startTimer();
    }
    
    // Seleccionar concepto
    function selectConcept(element, id) {
        if (element.classList.contains('matched')) return;
        
        // Deseleccionar anteriores
        document.querySelectorAll('.match-item.selected').forEach(el => {
            el.classList.remove('selected');
        });
        
        element.classList.add('selected');
        selectedConcept = { element, id };
    }
    
    // Seleccionar definición
    function selectDefinition(element, id) {
        if (element.classList.contains('matched') || !selectedConcept) return;
        
        if (selectedConcept.id === id) {
            // Correcto! Agregar clase matched para efecto glow
            selectedConcept.element.classList.remove('selected');
            selectedConcept.element.classList.add('matched');
            element.classList.add('matched');
            
            aciertos++;
            document.getElementById('aciertos').textContent = aciertos;
            
            selectedConcept = null;
            
            // Verificar si terminó
            if (aciertos === pairs.length) {
                setTimeout(finishGame, 500);
            }
        } else {
            // Incorrecto
            errores++;
            document.getElementById('errores').textContent = errores;
            
            element.classList.add('wrong');
            setTimeout(() => {
                element.classList.remove('wrong');
            }, 500);
            
            selectedConcept.element.classList.remove('selected');
            selectedConcept = null;
        }
    }
    
    // Finalizar juego
    function finishGame() {
        stopTimer();
        const timeElapsed = Date.now() - startTime;
        
        // Nueva fórmula de calificación basada en errores
        // Calificación = 10 - (errores / totalPares) * 5
        // Si no hay errores = 10
        // Si errores = totalPares, score = 5
        // Si errores > totalPares, puede bajar más
        let score = 10 - (errores / pairs.length) * 5;
        
        // Asegurar que esté entre 0 y 10
        score = Math.max(0, Math.min(10, score));
        
        document.getElementById('finalTime').textContent = formatTime(timeElapsed);
        document.getElementById('finalErrors').textContent = errores;
        document.getElementById('finalScore').textContent = score.toFixed(2);
        
        document.getElementById('victoryModal').style.display = 'flex';
        
        // Guardar
        if (idUsuario !== null) {
            document.getElementById('savingMessage').style.display = 'block';
            
            fetch('/Unidad/GuardarCalificacion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    IdUnidad: idUnidad,
                    IdUsuario: idUsuario,
                    Calificacion: parseFloat(score.toFixed(2)),
                    TiempoDedicado: timeElapsed / 60000
                })
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('savingMessage').style.display = 'none';
                const btn = document.getElementById('btnContinuar');
                btn.textContent = data.success ? 'Continuar' : 'Error (Continuar)';
                btn.onclick = () => window.location.href = returnURL;
                btn.style.display = 'inline-block';
                
                setTimeout(() => window.location.href = returnURL, 3000);
            })
            .catch(() => {
                document.getElementById('savingMessage').textContent = 'Error de conexión';
                const btn = document.getElementById('btnContinuar');
                btn.style.display = 'inline-block';
                btn.onclick = () => window.location.href = returnURL;
                setTimeout(() => window.location.href = returnURL, 3000);
            });
        } else {
            const btn = document.getElementById('btnContinuar');
            btn.style.display = 'inline-block';
            btn.onclick = () => window.location.href = returnURL;
        }
    }
    
    function formatTime(ms) {
        const minutes = Math.floor(ms / 60000);
        const seconds = Math.floor((ms % 60000) / 1000);
        return `${minutes} min ${seconds} seg`;
    }
    
    // Iniciar
    initGame();
</script>
