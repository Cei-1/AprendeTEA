        // Inicializar el tema al cargar
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "dark") enableDarkMode();
        else disableDarkMode();

        // Función auxiliar para móvil (Bootstrap md breakpoint es 768px)
        function isMobile() {
            return window.innerWidth < 768;
        }

        function handleMenuToggle() {
            navigation.classList.toggle("open");
            if (isMobile()) {
                mainContent.classList.toggle("menu-shifted");
            }
        }

        if (menuToggleMobile) {
            menuToggleMobile.onclick = handleMenuToggle;
        }

        function activarLink(event) {
            const clickedItem = event.currentTarget;
            if (clickedItem.id === "dark-mode-toggle") return;

            lists.forEach((item) => {
                if (item.id !== "dark-mode-toggle") item.classList.remove("active");
            });
            clickedItem.classList.add("active");

            if (navigation.classList.contains("open") && isMobile()) {
                setTimeout(() => {
                    navigation.classList.remove("open");
                    mainContent.classList.remove("menu-shifted");
                }, 300);
            }
        }

        if (darkModeToggle) {
            darkModeToggle.addEventListener("click", (e) => {
                e.preventDefault();
