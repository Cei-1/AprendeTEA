@{
    ViewData["Title"] = "Correo Confirmado";
}

<div class="card-bg p-5 rounded-4 shadow text-center mx-auto" style="max-width: 450px;">
    <img src="~/img/logo.png" class="mb-4" style="width: 70px;" />

    <h2 class="fw-bold text-alef-primary mb-3">¡Correo confirmado! 🎉</h2>

    <p class="text-muted mb-4">
        Tu cuenta ha sido activada correctamente.<br />
        Ahora puedes iniciar sesión.
    </p>

    <a class="btn btn-alef-submit px-4 py-2" href="@Url.Action("Index", "Login")">
        Iniciar Sesión
    </a>
</div>
