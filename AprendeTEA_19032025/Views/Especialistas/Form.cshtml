@model Especialista

@{
    ViewData["Title"] = Model.IdEspecialista == 0 ? "Nuevo Especialista" : "Editar Especialista";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header con Logo -->
<div class="mb-4 mb-md-5 d-flex flex-column align-items-center pt-4">
    <div class="hero-title-container mb-3 d-flex align-items-center gap-2 gap-md-3">
        <img src="~/img/logo.png"
             alt="Logo Neuro Pro"
             class="hero-logo"
             style="width: 3rem; height: 3rem; object-fit: contain;"
             onerror="this.style.display='none';" />

        <h2 class="display-5 display-md-4 m-0 fw-bold text-adaptive">
            NEURO PRO
        </h2>
    </div>
    <h3 class="h5 h4-md fw-semibold text-adaptive-inverse text-center px-3" style="max-width: 600px;">
        Rutas de Consciencia y Neurodiversidad
    </h3>
</div>

<div class="container my-4 my-md-5" style="max-width: 900px;">
    <div class="form-container p-3 p-md-5">

        <div class="mb-3 mb-md-4">
            <a asp-action="Index" asp-controller="Especialistas" class="link-back">
                <i data-lucide="arrow-left" style="width: 18px; height: 18px;" class="me-2"></i>
                Volver a la Lista
            </a>
        </div>

        <h2 class="h3 h2-md fw-bold mb-3 mb-md-4 neuropro-title text-center">
            @ViewData["Title"]
        </h2>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Form" asp-controller="Especialistas" method="post" enctype="multipart/form-data" class="d-flex flex-column gap-3 gap-md-4">
            <input type="hidden" asp-for="IdEspecialista" />
            <input type="hidden" asp-for="FotografiaBase64" id="hiddenFotografiaBase64" />

            <!-- Photo Section -->
            <div class="text-center mb-3">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.FotografiaBase64))
                    {
                        <img id="photoPreview" src="@Model.FotografiaBase64" alt="Foto del especialista" 
                             class="rounded-circle object-fit-cover border border-3 border-alef-primary shadow"
                             style="width: 120px; height: 120px;" />
                    }
                    else
                    {
                        <div id="photoPreview" class="rounded-circle bg-alef-primary-subtle d-inline-flex align-items-center justify-content-center border border-3 border-alef-primary"
                             style="width: 120px; height: 120px;">
                            <i data-lucide="user" class="text-alef-primary" style="width: 56px; height: 56px;"></i>
                        </div>
                    }
                </div>
                <label for="FotografiaFile" class="btn btn-outline-secondary btn-sm">
                    <i data-lucide="camera" style="width: 16px; height: 16px;" class="me-1"></i>
                    Cambiar Foto
                </label>
                <input type="file" id="FotografiaFile" name="FotografiaFile" accept="image/*" class="d-none" />
                <small class="d-block text-muted mt-2">Formatos: JPG, PNG, GIF. Máximo 5MB</small>
            </div>

            <!-- Personal Information -->
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="user" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Nombre *
                    </label>
                    <input asp-for="Nombre" class="form-control custom-input" placeholder="Ej. Juan" required />
                    <span asp-validation-for="Nombre" class="text-danger small mt-1 fw-bold d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="user" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Apellido Paterno *
                    </label>
                    <input asp-for="ApellidoPaterno" class="form-control custom-input" placeholder="Ej. Pérez" required />
                    <span asp-validation-for="ApellidoPaterno" class="text-danger small mt-1 fw-bold d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="user" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Apellido Materno
                    </label>
                    <input asp-for="ApellidoMaterno" class="form-control custom-input" placeholder="Ej. García" />
                </div>
            </div>

            <!-- Contact Information -->
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="mail" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Email
                    </label>
                    <input asp-for="Email" type="email" class="form-control custom-input" placeholder="ejemplo@correo.com" />
                    <span asp-validation-for="Email" class="text-danger small mt-1 fw-bold d-block"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="phone" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Teléfono
                    </label>
                    <input asp-for="Telefono" type="tel" class="form-control custom-input" placeholder="+52 555 123 4567" />
                </div>
            </div>

            <!-- Address Information -->
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="map" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Estado
                    </label>
                    <input asp-for="Estado" class="form-control custom-input" placeholder="Ej. Ciudad de México" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="map-pin" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Municipio
                    </label>
                    <input asp-for="Municipio" class="form-control custom-input" placeholder="Ej. Coyoacán" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                        <i data-lucide="home" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                        Colonia
                    </label>
                    <input asp-for="Colonia" class="form-control custom-input" placeholder="Ej. Del Valle" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 gap-sm-3 pt-3 pt-md-4 border-top border-secondary border-opacity-25 mt-2">
                <div class="order-2 order-sm-1">
                    @if (Model.IdEspecialista > 0)
                    {
                        <button type="button" 
                                class="btn btn-danger py-2 px-3 px-md-4 d-flex align-items-center gap-2 w-100 w-sm-auto justify-content-center"
                                data-bs-toggle="modal" 
                                data-bs-target="#deleteModal">
                            <i data-lucide="trash-2" style="width: 16px; height: 16px;"></i>
                            Eliminar
                        </button>
                    }
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-3 order-1 order-sm-2">
                    <a asp-action="Index" 
                       class="btn btn-cancel-custom py-2 px-3 px-md-4 d-flex align-items-center gap-2 w-100 w-sm-auto justify-content-center order-2 order-sm-1">
                        <i data-lucide="x" style="width: 16px; height: 16px;"></i>
                        Cancelar
                    </a>

                    <button type="submit" 
                            class="btn btn-alef-submit py-2 px-4 px-md-5 d-flex align-items-center gap-2 shadow w-100 w-sm-auto justify-content-center order-1 order-sm-2">
                        <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (Model.IdEspecialista > 0)
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-bg">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-body-custom" id="deleteModalLabel">
                        <i data-lucide="alert-triangle" class="text-danger me-2" style="width: 24px; height: 24px;"></i>
                        Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 text-body-custom">¿Estás seguro de que deseas eliminar a <strong>@Model.NombreCompleto</strong>?</p>
                    <p class="text-danger small mt-2 mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <a asp-action="Delete" 
                       asp-controller="Especialistas" 
                       asp-route-IdEspecialista="@Model.IdEspecialista" 
                       class="btn btn-danger">
                        Eliminar Definitivamente
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Image preview functionality
            const fileInput = document.getElementById('FotografiaFile');
            const photoPreview = document.getElementById('photoPreview');

            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    // Validate file size (5MB)
                    if (file.size > 5 * 1024 * 1024) {
                        alert('La imagen no puede superar los 5MB');
                        fileInput.value = '';
                        return;
                    }

                    // Validate file type
                    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(file.type)) {
                        alert('Solo se permiten imágenes (JPG, PNG, GIF)');
                        fileInput.value = '';
                        return;
                    }

                    // Preview the image
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        // Check if photoPreview is an img or div
                        if (photoPreview.tagName === 'IMG') {
                            photoPreview.src = event.target.result;
                        } else {
                            // Replace div with img
                            const newImg = document.createElement('img');
                            newImg.id = 'photoPreview';
                            newImg.src = event.target.result;
                            newImg.alt = 'Foto del especialista';
                            newImg.className = 'rounded-circle object-fit-cover border border-3 border-alef-primary shadow';
                            newImg.style.width = '150px';
                            newImg.style.height = '150px';
                            photoPreview.parentNode.replaceChild(newImg, photoPreview);
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
