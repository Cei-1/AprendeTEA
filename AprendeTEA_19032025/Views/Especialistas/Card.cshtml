@model Especialista

@{
    ViewData["Title"] = Model.NombreCompleto;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #specialist-card {
        max-width: 600px;
        margin: 0 auto;
        background: var(--alef-primary);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        position: relative;
        overflow: hidden;
    }

    body.dark-mode #specialist-card {
        background: var(--alef-secondary);
    }

    #specialist-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    .card-header-section {
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .specialist-photo {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 5px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        object-fit: cover;
        margin: 0 auto 20px;
        display: block;
    }

    .specialist-name {
        color: white;
        font-size: 1.75rem;
        font-weight: bold;
        margin-bottom: 8px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
    }

    .specialist-title {
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.1rem;
        margin-bottom: 25px;
        font-weight: 500;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 25px;
    }

    .info-item {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: transform 0.2s, background 0.2s;
    }

    .info-item:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.2);
    }

    .info-icon {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.8rem;
        margin-bottom: 2px;
        font-weight: 500;
    }

    .info-value {
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        word-break: break-word;
    }

    .share-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 25px;
    }

    media (min-width: 576px) {
        .share-buttons {
            flex-direction: row;
            justify-content: center;
        }

        #specialist-card {
            padding: 40px;
        }

        .specialist-photo {
            width: 180px;
            height: 180px;
        }

        .specialist-name {
            font-size: 2rem;
        }

        .specialist-title {
            font-size: 1.2rem;
        }

        .info-item {
            padding: 15px 20px;
        }
    }

    .btn-share {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.3);
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s;
        backdrop-filter: blur(10px);
        width: 100%;
    }

    media (min-width: 576px) {
        .btn-share {
            width: auto;
            padding: 10px 25px;
        }
    }

    .btn-share:hover {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.5);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
</style>

<!-- Header con Logo -->
<div class="mb-4 mb-md-5 d-flex flex-column align-items-center pt-4">
    <div class="hero-title-container mb-3 d-flex align-items-center gap-2 gap-md-3">
        <img src="~/img/logo.png"
             alt="Logo Neuro Pro"
             class="hero-logo"
             style="width: 3rem; height: 3rem; object-fit: contain;"
             onerror="this.style.display='none';" />

        <h2 class="display-5 display-md-4 m-0 fw-bold text-adaptive">
            NEURO PRO
        </h2>
    </div>
    <h3 class="h5 h4-md fw-semibold text-adaptive-inverse text-center px-3" style="max-width: 600px;">
        Rutas de Consciencia y Neurodiversidad
    </h3>
</div>

<div class="container my-4 my-md-5">
    <div class="text-center mb-4">
        <a asp-action="Catalogo" class="btn btn-outline-secondary">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;" class="me-2"></i>
            Volver al Catálogo
        </a>
    </div>

    <div id="specialist-card">
        <div class="card-header-section">
            @if (!string.IsNullOrEmpty(Model.FotografiaBase64))
            {
                <img src="@Model.FotografiaBase64" alt="@Model.NombreCompleto" class="specialist-photo" />
            }
            else
            {
                <div class="specialist-photo d-flex align-items-center justify-content-center" style="background: rgba(255, 255, 255, 0.2);">
                    <i data-lucide="user" style="width: 80px; height: 80px; color: white;"></i>
                </div>
            }

            <h1 class="specialist-name">@Model.NombreCompleto</h1>
            <p class="specialist-title">Especialista en TEA</p>
        </div>

        <div class="info-grid">
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <div class="info-item">
                    <div class="info-icon">
                        <i data-lucide="mail" style="width: 20px; height: 20px; color: white;"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Telefono))
            {
                <div class="info-item">
                    <div class="info-icon">
                        <i data-lucide="phone" style="width: 20px; height: 20px; color: white;"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Teléfono</div>
                        <div class="info-value">@Model.Telefono</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Municipio) || !string.IsNullOrEmpty(Model.Estado))
            {
                <div class="info-item">
                    <div class="info-icon">
                        <i data-lucide="map-pin" style="width: 20px; height: 20px; color: white;"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Ubicación</div>
                        <div class="info-value">
                            @if (!string.IsNullOrEmpty(Model.Colonia))
                            {
                                @Model.Colonia<text>, </text>
                            }
                            @if (!string.IsNullOrEmpty(Model.Municipio))
                            {
                                @Model.Municipio<text>, </text>
                            }
                            @Model.Estado
                        </div>
                    </div>
                </div>
            }

            @if (Model.FechaRegistro != null)
            {
                <div class="info-item">
                    <div class="info-icon">
                        <i data-lucide="calendar" style="width: 20px; height: 20px; color: white;"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Registrado desde</div>
                        <div class="info-value">@Model.FechaRegistro.Value.ToString("MMMM yyyy")</div>
                    </div>
                </div>
            }
    </div>

    <div class="share-buttons">
        <button id="shareImageBtn" class="btn btn-share">
            <i data-lucide="share-2" style="width: 16px; height: 16px;" class="me-2"></i>
            Compartir como Imagen
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            document.getElementById('shareImageBtn').addEventListener('click', async function() {
                const card = document.getElementById('specialist-card');
                const button = this;

                // Disable button while processing
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Generando...';

                try {
                    const canvas = await html2canvas(card, {
                        backgroundColor: null,
                        scale: 2,
                        logging: false,
                        useCORS: true,
                        allowTaint: true
                    });

                    canvas.toBlob(async function(blob) {
                        const fileName = '@Model.NombreCompleto.Replace(" ", "_")_TEA.png';

                        // Try to use native share API if available (mobile)
                        if (navigator.share && navigator.canShare) {
                            const file = new File([blob], fileName, { type: 'image/png' });
                            const shareData = {
                                files: [file],
                                title: '@Model.NombreCompleto',
                                text: 'Especialista en TEA'
                            };

                            if (navigator.canShare(shareData)) {
                                try {
                                    await navigator.share(shareData);
                                    button.disabled = false;
                                    button.innerHTML = '<i data-lucide="share-2" style="width: 18px; height: 18px;" class="me-2"></i>Compartir como Imagen';
                                    lucide.createIcons();
                                    return;
                                } catch (err) {
                                    // User cancelled or error, fall through to download
                                }
                            }
                        }

                        // Fallback to download
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);

                        button.disabled = false;
                        button.innerHTML = '<i data-lucide="check" style="width: 18px; height: 18px;" class="me-2"></i>¡Descargado!';
                        lucide.createIcons();

                        setTimeout(() => {
                            button.innerHTML = '<i data-lucide="share-2" style="width: 18px; height: 18px;" class="me-2"></i>Compartir como Imagen';
                            lucide.createIcons();
                        }, 2000);
                    }, 'image/png');
                } catch (error) {
                    console.error('Error generating image:', error);
                    alert('Hubo un error al generar la imagen. Por favor intenta de nuevo.');
                    button.disabled = false;
                    button.innerHTML = '<i data-lucide="share-2" style="width: 18px; height: 18px;" class="me-2"></i>Compartir como Imagen';
                    lucide.createIcons();
                }
            });
        });
    </script>
}
