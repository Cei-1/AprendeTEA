@{
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <style>
        #dialog-bubble {
            position: absolute;
            top: 20px;
            right: 80%;
            background-color: white;
            border: 4px solid #70369d;
            color: #333;
            border-radius: 25px 50px 25px 50px;
            padding: 12px 18px;
            font-size: 1.1em;
            white-space: nowrap;
            z-index: 30;
            font-weight: 600;
            text-align: center;
            box-shadow: 0 8px 15px rgba(112, 54, 157, 0.4);
            opacity: 0;
            transform: scale(0.5);
            transition: opacity 0.3s ease-out, transform 0.3s ease-out;
            animation: pulse-shadow 4s ease-in-out infinite alternate;
        }

        body[data-mode="dark"] #dialog-bubble {
            background-color: #374151;
            border: 4px solid #487de7;
            color: #e5e7eb;
            box-shadow: 0 8px 15px rgba(72, 125, 231, 0.4);
        }

        #dialog-bubble::after {
            background-color: #70369d;
            content: "";
            position: absolute;
            right: -20px;
            top: 50%;
            transform: translateY(-50%) rotate(45deg);
            width: 20px;
            height: 20px;
            border-radius: 0 5px 0 5px;
            z-index: 31;
        }
        body[data-mode="dark"] #dialog-bubble::after { background-color: #487de7; }

        #dialog-bubble::before {
            background-color: white;
            content: "";
            position: absolute;
            right: -17px;
            top: 50%;
            transform: translateY(-50%) rotate(45deg);
            width: 14px;
            height: 14px;
            border-radius: 0 3px 0 3px;
            z-index: 32;
        }
        body[data-mode="dark"] #dialog-bubble::before { background-color: #374151; }

        #dialog-bubble.show {
            opacity: 1;
            transform: scale(1);
            animation: pop-in 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards, pulse-shadow 4s ease-in-out infinite alternate;
        }
    </style>
}

<section id="que-es" class="mb-5 pt-4 pt-md-5">
    <div class="container-fluid" style="max-width: 80rem;">
        <div class="row align-items-center g-5">

            <div class="col-md-7">
                <h2 class="display-4 fw-bold mb-4 magical-title">
                    SORPRENDIZAJE MÁGICO
                </h2>
                <h3 class="h2 fw-semibold mb-4 text-alef-secondary">
                    Despertando el Potencial Innato a través de la Neuroeducación Consciente
                </h3>
                <p class="fs-5 fw-light text-body-custom mb-4">
                    Es un programa especializado en el cuidado y la gestión emocional, así como en el entrenamiento mental y espiritual.
                </p>
                <pclass="fs-6 fw-light text-body-custom">
                    A través del <strong>Método Sorprendizaje Mágico</strong>, integramos los principios de la neuroeducación con herramientas de mentoría, planificación, gestión mental e inteligencia emocional.
                </p>
                <a href="#mision" class="mt-4 d-inline-block btn btn-lg bg-alef-secondary text-white fw-bold shadow">
                    Descubra Nuestra Filosofía
                </a>
            </div>

            <div class="col-md-5 d-none d-md-block position-relative text-center">
                <div id="magical-pet-container" class="position-relative w-100 mx-auto" style="max-width: 350px;">
                    <div id="dialog-bubble" class="d-none position-absolute"></div>
                    <img src="~/img/mago.png"
                         alt="Mago de Sorprendizaje"
                         class="img-fluid rounded-3 magical-pet"
                         style="filter: drop-shadow(0 10px 8px rgba(0,0,0,0.2));"
                         onerror="this.onerror=null; this.src='https://placehold.co/350x450/70369d/ffffff?text=MAGO+PNG';"
                         onclick="castMagicSpell()" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="mision" class="mb-5 container-fluid" style="max-width: 1320px;">
    <div class="text-center mb-5">
        <h3 class="d-inline-block display-6 fw-bold border-bottom border-4 border-alef-secondary pb-2 magical-title">
            Misión y Visión
        </h3>
    </div>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="p-4 p-md-5 card-bg rounded-3 shadow l-border-card l-border-red h-100">
                <h4 class="h2 fw-bold text-alef-primary mb-3 d-flex align-items-center">
                    <i data-lucide="scroll-text" class="me-2 text-alef-red" style="width: 32px; height: 32px;"></i> Nuestra Misión
                </h4>
                <p class="fs-6 text-body-custom lh-base">
                    Brindar conocimiento, aprendizaje y consciencia como una auténtica expresión de la personalidad de cada individuo.
                </p>
                <p class="mt-4 small text-muted fst-italic">
                    <em>Propósito: Fomentar una mentalidad de crecimiento que inspire vidas más plenas.</em>
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="p-4 p-md-5 card-bg rounded-3 shadow l-border-card l-border-blue h-100">
                <h4 class="h2 fw-bold text-alef-primary mb-3 d-flex align-items-center">
                    <i data-lucide="eye" class="me-2 text-alef-blue" style="width: 32px; height: 32px;"></i> Nuestra Visión
                </h4>
                <p class="fs-6 text-body-custom lh-base">
                    Ser un referente global en el desarrollo integral del ser humano, a través de un programa innovador y efectivo.
                </p>
                <p class="mt-4 small text-muted fst-italic">
                    <em>Aspiramos a inspirar a las personas mediante un método especializado.</em>
                </p>
            </div>
        </div>
    </div>
</section>

