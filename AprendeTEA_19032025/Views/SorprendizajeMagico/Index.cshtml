<section id="valores" class="mb-5 py-5 px-3 px-md-5 card-bg rounded-3 shadow-lg container-fluid" style="max-width: 1320px;">
    <div class="text-center mb-5">
        <h3 class="d-inline-block display-6 fw-bold border-bottom border-4 border-alef-secondary pb-2 magical-title">
            Nuestros Valores Fundamentales
        </h3>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- Tarjeta 1: Sorprendizaje (Naranja) -->
        <div class="col">
            <div class="p-4 card-bg rounded-3 shadow-sm l-border-card l-border-orange h-100">
                <div class="d-flex align-items-center mb-3">
                    <i data-lucide="sparkles" class="text-alef-orange me-2" style="width: 32px; height: 32px;"></i>
                    <h4 class="h5 fw-bold text-alef-primary mb-0">1. Sorprendizaje</h4>
                </div>
                <p class="small text-body-custom lh-base mb-0">
                    La capacidad de maravillarse por la vida y su experiencia al aprender a enfrentarse a un reto "imposible de vencer" y asumirlo con consciencia y propósito. Impulsamos el interés por descubrir, comprender y construir soluciones.
                </p>
            </div>
        </div>

        <!-- Tarjeta 2: Creatividad (Amarillo) -->
        <div class="col">
            <div class="p-4 card-bg rounded-3 shadow-sm l-border-card l-border-yellow h-100">
                <div class="d-flex align-items-center mb-3">
                    <ion-icon name="bulb-outline" class="text-alef-yellow me-2" style="font-size: 32px;"></ion-icon>
                    <h4 class="h5 fw-bold text-alef-primary mb-0">2. Creatividad</h4>
                </div>
                <p class="small text-body-custom lh-base mb-0">
                    Promovemos la originalidad y la innovación en el diseño de nuestros programas, impulsando la expresión auténtica y el potencial creativo de cada aprendiz.
                </p>
            </div>
        </div>

        <!-- Tarjeta 3: Calidad (Rojo) -->
        <div class="col">
            <div class="p-4 card-bg rounded-3 shadow-sm l-border-card l-border-red h-100">
                <div class="d-flex align-items-center mb-3">
                    <i data-lucide="medal" class="text-alef-red me-2" style="width: 32px; height: 32px;"></i>
                    <h4 class="h5 fw-bold text-alef-primary mb-0">3. Calidad</h4>
                </div>
                <p class="small text-body-custom lh-base mb-0">
                    Garantizamos la excelencia en cada detalle y en la conexión que establecemos, generando experiencias duraderas y significativas que contribuyen a la trascendencia personal.
                </p>
            </div>
        </div>

        <!-- Tarjeta 4: Autenticidad (Violeta) -->
        <div class="col">
            <div class="p-4 card-bg rounded-3 shadow-sm l-border-card l-border-violet h-100">
                <div class="d-flex align-items-center mb-3">
                    <i data-lucide="fingerprint" class="text-alef-violet me-2" style="width: 32px; height: 32px;"></i>
                    <h4 class="h5 fw-bold text-alef-primary mb-0">4. Autenticidad</h4>
                </div>
                <p class="small text-body-custom lh-base mb-0">
                    Valoramos la individualidad y el desarrollo innato de cada persona, ofreciendo experiencias de aprendizaje únicas que reflejan su personalidad, estilo y propósito.
                </p>
            </div>
        </div>

        <!-- Tarjeta 5: Sostenibilidad (Verde) -->
        <div class="col">
            <div class="p-4 card-bg rounded-3 shadow-sm l-border-card l-border-green h-100">
                <div class="d-flex align-items-center mb-3">
                    <i data-lucide="leaf" class="text-alef-green me-2" style="width: 32px; height: 32px;"></i>
                    <h4 class="h5 fw-bold text-alef-primary mb-0">5. Sostenibilidad</h4>
                </div>
                <p class="small text-body-custom lh-base mb-0">
                    Fomentamos prácticas conscientes y responsables, buscando alternativas sostenibles que promuevan una mentalidad de crecimiento en la vida cotidiana. Creemos en la efectividad antes que en la perfección.
                </p>
            </div>
        </div>
    </div>
</section>

<section id="contacto" class="mb-5 p-4 p-md-5 card-bg rounded-3 shadow-lg container-fluid" style="max-width: 900px;">
    <div class="text-center">
        <h3 class="display-6 fw-bold mb-4 magical-title border-bottom border-4 border-alef-primary pb-2 d-inline-block">
            ¿Listo para Despertar tu Potencial?
        </h3>
        <p class="fs-5 mb-4 text-body-custom">Contáctenos para una consulta personalizada.</p>
        <form class="text-start">
            <div class="mb-3">
                <input type="text" placeholder="Su Nombre" class="form-control form-control-lg" required />
            </div>
            <div class="mb-3">
                <input type="email" placeholder="Correo Electrónico" class="form-control form-control-lg" required />
            </div>
            <div class="mb-3">
                <textarea placeholder="Cuéntenos su objetivo" rows="3" class="form-control form-control-lg"></textarea>
            </div>
            <button type="submit" class="btn btn-lg w-100 bg-alef-secondary text-white fw-bold shadow">
                Enviar Consulta
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        // Magia
        const dialogBubble = document.getElementById("dialog-bubble");
        const magicalPetContainer = document.getElementById("magical-pet-container");
        const magicalPet = document.querySelector(".magical-pet");
        const magicPhrases = [
            "¡Despierta tu potencial innato!", "La Neuroeducación es Magia.",
            "¡Piensa diferente, crea diferente!", "Consciencia: El primer paso.",
            "¿En qué piensas hoy?", "El aprendizaje nunca termina."
        ];
        let magicTimer = null;
        let isCasting = false;

        function showMagicDialog() {
            const randomIndex = Math.floor(Math.random() * magicPhrases.length);
            dialogBubble.textContent = magicPhrases[randomIndex];
            dialogBubble.classList.add("show");
            dialogBubble.classList.remove("d-none");
            setTimeout(() => {
                dialogBubble.classList.remove("show");
                setTimeout(() => { dialogBubble.classList.add("d-none"); }, 300);
            }, 4000);
        }

        function startMagicTimer() {
            const minTime = 8000;
            const maxTime = 15000;
            const randomDelay = Math.floor(Math.random() * (maxTime - minTime + 1)) + minTime;
            clearTimeout(magicTimer);
            magicTimer = setTimeout(() => {
                showMagicDialog();
                startMagicTimer();
            }, randomDelay);
        }

        function createSparkle(x, y, color) {
            const sparkle = document.createElement("div");
            sparkle.classList.add("sparkle-effect");
            sparkle.style.left = `${x}px`;
            sparkle.style.top = `${y}px`;
            sparkle.style.setProperty("--sparkle-color", color);
            const dx = (Math.random() - 0.5) * 200;
            const dy = (Math.random() - 0.5) * 200;
            sparkle.style.setProperty("--x", `${dx}px`);
            sparkle.style.setProperty("--y", `${dy}px`);
            magicalPetContainer.appendChild(sparkle);
            setTimeout(() => { sparkle.remove(); }, 1000);
        }

        window.castMagicSpell = function () {
            if (isCasting) return;
            isCasting = true;
            clearTimeout(magicTimer);
            dialogBubble.classList.add("d-none");
            const rect = magicalPet.getBoundingClientRect();
            const containerRect = magicalPetContainer.getBoundingClientRect();
            const centerX = rect.left - containerRect.left + rect.width / 2;
            const centerY = rect.top - containerRect.top + rect.height / 2;
            const colors = ["#70369d", "#487de7", "#faeb36", "#ffffff", "#ffa500", "#70369d"];
            for (let i = 0; i < 100; i++) {
                const randomColor = colors[Math.floor(Math.random() * colors.length)];
                const offsetX = (Math.random() - 0.5) * rect.width * 0.5;
                const offsetY = (Math.random() - 0.5) * rect.height * 0.5;
                createSparkle(centerX + offsetX, centerY + offsetY, randomColor);
            }
            setTimeout(() => {
                isCasting = false;
                startMagicTimer();
            }, 1000);
        };

        if (magicalPetContainer) { startMagicTimer(); }
    </script>
}
