@model PlanTrabajo

@{
    ViewData["Title"] = Model.IdPlanTrabajo == 0 ? "Nuevo Plan" : "Editar Plan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <form asp-action="Form" asp-controller="PlanTrabajo" method="post">
        <input type="hidden" asp-for="IdPlanTrabajo" />

        <div class="mb-3">
            <label class="form-label">Nombre del Plan</label>
            <input asp-for="NombrePlan" class="form-control" />
            <span asp-validation-for="NombrePlan" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
