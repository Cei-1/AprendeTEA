@model PlanTrabajo

@{
    ViewData["Title"] = Model.IdPlanTrabajo == 0 ? "Nuevo Plan de Trabajo" : "Editar Plan de Trabajo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5" style="max-width: 700px;">
    <div class="form-container p-4 p-md-5">

        <div class="mb-4">
            <a asp-action="Index" asp-controller="PlanTrabajo" class="link-back">
                <i data-lucide="arrow-left" style="width: 20px; height: 20px;" class="me-2"></i>
                Volver al Directorio
            </a>
        </div>

        <h2 class="h2 fw-bold mb-4 neuropro-title text-center">
            @ViewData["Title"]
        </h2>

        <form asp-action="Form" asp-controller="PlanTrabajo" method="post" class="d-flex flex-column gap-4">
            <input type="hidden" asp-for="IdPlanTrabajo" />

            <div>
                <label class="form-label fw-bold d-flex align-items-center text-body-custom mb-2">
                    <i data-lucide="book-open" class="text-alef-primary me-2" style="width: 16px; height: 16px;"></i>
                    Nombre del Plan
                </label>

                <div class="position-relative">
                    <div class="position-absolute top-50 start-0 translate-middle-y ps-3 pe-2" style="pointer-events: none;">
                        <i data-lucide="edit-3" class="text-muted-custom" style="width: 20px; height: 20px;"></i>
                    </div>

                    <input asp-for="NombrePlan"
                           class="form-control form-control-lg ps-5 custom-input py-3"
                           placeholder="Ej. Plan de Desarrollo Cognitivo para TEA" />
                </div>
                <span asp-validation-for="NombrePlan" class="text-danger small mt-1 fw-bold d-block"></span>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-3 pt-4 border-top border-secondary border-opacity-25 mt-2">

                <a asp-action="Index"
                   class="btn btn-cancel-custom py-3 px-4 d-flex align-items-center justify-content-center fw-bold">
                    <i data-lucide="x" style="width: 16px; height: 16px;" class="me-2"></i>
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-alef-submit py-3 px-5 d-flex align-items-center justify-content-center fw-bold shadow">
                    <i data-lucide="save" style="width: 16px; height: 16px;" class="me-2"></i>
                    Guardar Plan
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
