@model PlanTrabajo

@{
    ViewData["Title"] = "Actividades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4 mb-md-5 d-flex flex-column align-items-center pt-4">
    <div class="hero-title-container mb-3 d-flex align-items-center gap-2 gap-md-3">
        <img src="~/img/logo.png"
             alt="Logo Neuro Pro"
             class="hero-logo"
             style="width: 3rem; height: 3rem; object-fit: contain;"
             onerror="this.style.display='none';" />

        <h2 class="display-5 display-md-4 m-0 fw-bold text-adaptive">
            NEURO PRO
        </h2>
    </div>
    <h3 class="h5 h4-md fw-semibold text-adaptive-inverse text-center px-3" style="max-width: 600px;">
        Rutas de Consciencia y Neurodiversidad
    </h3>
</div>

<section class="mb-5 pb-5">
    <div class="container" style="max-width: 900px;">

        <header class="mb-5 border-bottom border-4 border-alef-primary pb-3 text-center opacity-75">
            <h1 class="h2 fw-bold mb-2 neuropro-title">
                Planes de Trabajo para el Espectro Autista
            </h1>
            <p class="lead fs-6 text-body-custom fw-medium">
                Explora nuestras unidades de aprendizaje interactivas.
            </p>
        </header>

        <div class="d-flex justify-content-center justify-content-md-end mb-4">
            <a asp-action="Form" asp-controller="PlanTrabajo"
               class="btn text-white fw-bold rounded-pill shadow px-4 d-flex align-items-center"
               style="background-color: #10b981; border: none;">
                <i data-lucide="plus-circle" class="me-2" style="width: 20px; height: 20px;"></i>
                Nuevo Plan
            </a>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-primary shadow-sm border-start border-4 border-primary" role="alert">
                <p class="m-0">@TempData["Mensaje"]</p>
            </div>
        }

        <div class="mb-5">
            <h2 class="h3 fw-bold text-adaptive mb-4 pb-2 border-bottom border-opacity-25 border-secondary">
                Planes de Estudio Disponibles
            </h2>

            <div id="course-list" class="d-flex flex-column gap-3">
                @if (Model.PlanesTrabajo != null && Model.PlanesTrabajo.Count > 0)
                {
                    foreach (PlanTrabajo plan in Model.PlanesTrabajo)
                    {
                        <div class="accordion-item">
                            <div class="accordion-header d-flex align-items-center p-3 p-md-4">
                                <i data-lucide="brain-circuit" class="me-3 text-alef-secondary" style="width: 28px; height: 28px;"></i>

                                <span class="flex-grow-1 h5 m-0 fw-bold">@plan.NombrePlan</span>

                                <span class="small fw-medium text-muted-custom me-3 d-none d-sm-inline">
                                    Plan #@plan.IdPlanTrabajo
                                </span>

                                <i data-lucide="chevron-down" style="width: 24px; height: 24px;"></i>
                            </div>

                            <div class="accordion-content">
                                <div class="p-4 border-top border-secondary border-opacity-10">
                                    <p class="text-body-custom mb-3 lh-base">
                                        Un plan esencial para padres, cuidadores y educadores. Entiende el Trastorno del Espectro Autista (TEA) desde una perspectiva de derechos y fortalezas, desmitificando el diagnóstico y abriendo la puerta a la comprensión empática.
                                    </p>

                                    <div class="d-flex justify-content-end pt-2">
                                        <a asp-action="Index" asp-controller="Unidad" asp-route-IdPlanTrabajo="@plan.IdPlanTrabajo"
                                           class="btn text-white fw-bold rounded-pill shadow-sm px-4"
                                           style="background-color: var(--alef-secondary); border: none;">
                                            Ver Unidades
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-5 rounded-3 shadow card-bg">
                        <div class="mb-3">
                            <i data-lucide="book-open" class="text-muted-custom" style="width: 64px; height: 64px; opacity: 0.5;"></i>
                        </div>
                        <h3 class="h4 fw-bold text-body-custom">No hay planes de trabajo aún</h3>
                        <p class="text-muted-custom mt-2">¡Crea el primero para comenzar tu viaje de aprendizaje!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Inicializar iconos
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Lógica del Acordeón (JS Puro adaptado a las nuevas clases)
            const headers = document.querySelectorAll(".accordion-header");

            headers.forEach((header) => {
                header.addEventListener("click", () => {
                    const item = header.parentElement; // El .accordion-item
                    const content = header.nextElementSibling; // El .accordion-content
                    const icon = header.querySelector('[data-lucide="chevron-down"]');

                    if (!content) return;

                    const isClosed = !header.classList.contains("open");

                    // 1. Cerrar TODOS los otros items
                    document.querySelectorAll(".accordion-item").forEach((otherItem) => {
                        if (otherItem !== item) {
                            const otherContent = otherItem.querySelector(".accordion-content");
                            const otherHeader = otherItem.querySelector(".accordion-header");
                            const otherIcon = otherItem.querySelector('[data-lucide="chevron-down"]');

                            if (otherContent) otherContent.style.maxHeight = "0px";
                            if (otherHeader) otherHeader.classList.remove("open");
                            if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
                        }
                    });

                    // 2. Abrir o Cerrar el actual
                    if (isClosed) {
                        content.style.maxHeight = content.scrollHeight + "px";
                        header.classList.add("open");
                        if(icon) icon.style.transform = "rotate(180deg)";
                    } else {
                        content.style.maxHeight = "0px";
                        header.classList.remove("open");
                        if(icon) icon.style.transform = "rotate(0deg)";
                    }
                });
            });
        });
    </script>
}

