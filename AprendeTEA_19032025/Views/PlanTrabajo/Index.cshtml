@model PlanTrabajo

@{
    ViewData["Title"] = "Planes de Trabajo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <div class="text-center pb-4">
            <h2>Planes de Trabajo</h2>
        </div>
    </div>

    <div class="row align-items-center mb-3">
        <div class="col-md-6">
            <h5>Seleccione un plan para visualizar sus unidades o + para agregar...</h5>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Form" asp-controller="PlanTrabajo" class="btn btn-success me-2">+</a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info">@TempData["Mensaje"]</div>
    }

    <hr />

    @if (Model.PlanesTrabajo != null && Model.PlanesTrabajo.Count > 0)
    {
        <div class="row">
            <table id="example" class="table table-striped" style="width:100%">
                <thead>
                    <tr class="table-info">
                        <th>ID</th>
                        <th>Nombre del Plan</th>
                        <th>Unidades</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @* @foreach (var plan in Model.PlanesTrabajo.Cast<AprendeTEA_19032025.Models.PlanTrabajo>()) *@
                    @foreach (PlanTrabajo plan in Model.PlanesTrabajo)
                    {
                        <tr>
                            <td class="text-white">@plan.IdPlanTrabajo</td>
                            <td  class="text-white">@plan.NombrePlan</td>
                            <td class="text-center">
                                <a class="btn btn-outline-primary text-white bg-primary"
                                   asp-action="Index"
                                   asp-controller="Unidad"
                                   asp-route-IdPlanTrabajo="@plan.IdPlanTrabajo">
                                    Ver Unidades
                                </a>
                            </td>
                            <td class="text-center">
                                <a class="btn btn-outline-danger text-white bg-danger"
                                   asp-action="Delete"
                                   asp-controller="PlanTrabajo"
                                   asp-route-IdPlanTrabajo="@plan.IdPlanTrabajo"
                                   onclick="return confirm('¿Estás seguro de eliminar este plan?');">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="row m-5">
            <div class="col">
                <div class="alert alert-warning" role="alert">
                    No existen registros. Da clic en + para agregar más información.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/DataTables/datatables.min.js"></script>
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet">

    <script>
        $(document).ready(function () {
            $('#example').DataTable({
                "language": {
                    "sProcessing": "Procesando...",
                    "sLengthMenu": "Mostrar _MENU_ registros",
                    "sZeroRecords": "No se encontraron resultados",
                    "sEmptyTable": "Ningún dato disponible en esta tabla",
                    "sInfo": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    "sInfoEmpty": "Mostrando 0 a 0 de 0 registros",
                    "sInfoFiltered": "(filtrado de _MAX_ registros)",
                    "sSearch": "Buscar:",
                    "oPaginate": {
                        "sFirst": "Primero",
                        "sLast": "Último",
                        "sNext": "Siguiente",
                        "sPrevious": "Anterior"
                    }
                }
            });
        });
    </script>
}
