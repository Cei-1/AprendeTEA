@model AprendeTEA_19032025.Models.Perfil

@{
    ViewData["Title"] = "Mi Perfil";

    string nombreCompleto = string.IsNullOrWhiteSpace(Model?.NombreCompleto)
        ? Model?.Email
        : Model.NombreCompleto;

    string ubicacion = (!string.IsNullOrWhiteSpace(Model?.Estado) || !string.IsNullOrWhiteSpace(Model?.Municipio))
        ? $"{Model?.Estado}, {Model?.Municipio}".Trim().Trim(',', ' ')
        : "Sin ubicación registrada";

    string telefono = string.IsNullOrWhiteSpace(Model?.Telefono)
        ? "Sin teléfono"
        : Model.Telefono;

    string cumple = Model?.FechaNacimiento.HasValue == true
        ? Model.FechaNacimiento.Value.ToString("dd 'de' MMMM")
        : "Sin registro";

    // Foto: si hay Base64 la usamos; si no, ui-avatars
    string fotoPerfil = string.IsNullOrEmpty(Model?.FotoBase64)
        ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(nombreCompleto ?? "Usuario")}&background=729BFF&color=fff&size=256"
        : $"data:image/png;base64,{Model.FotoBase64}";
}

<div class="d-flex justify-content-between align-items-center mb-5 card-bg p-4 rounded-4 shadow-sm">
    <div class="d-flex align-items-center gap-3">
        <div class="p-2 rounded-3 bg-alef-primary-subtle">
            <img src="~/img/logo.png" alt="Logo" style="width: 32px; height: 32px; object-fit: contain;"
                 onerror="this.onerror=null; this.src='https://placehold.co/40x40/729BFF/ffffff?text=NP';" />
        </div>
        <div>
            <h1 class="h4 fw-bold text-body-custom m-0">Hola, @nombreCompleto</h1>
            <p class="small text-muted-custom m-0">¡Listo para seguir aprendiendo!</p>
        </div>
    </div>

    <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-link text-muted-custom p-2" title="Cerrar Sesión">
            <i data-lucide="log-out" style="width: 24px; height: 24px;"></i>
        </button>
    </form>
</div>

@if (TempData["PerfilMensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["PerfilMensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<div class="container-fluid px-0">
    <div class="profile-banner-bg shadow-sm">
        <div class="position-absolute top-0 end-0 bg-white opacity-10 rounded-circle"
             style="width: 200px; height: 200px; transform: translate(50px, -50px); filter: blur(40px);"></div>
        <div class="position-absolute bottom-0 start-0 bg-danger opacity-10 rounded-circle"
             style="width: 200px; height: 200px; filter: blur(40px);"></div>
    </div>

    <div class="card-bg profile-floating-card shadow-lg mx-3 mx-md-5 position-relative">
        <div class="row align-items-end">
            <!-- Avatar con foto real o avatar automático -->
            <div class="col-md-auto text-center text-md-start position-relative">
                <div class="d-inline-block position-relative" style="margin-top: -5rem;">
                    <img src="@fotoPerfil"
                         alt="Avatar" class="profile-avatar-lg" style="object-fit: cover;" />
                    <div class="status-indicator-online" title="En línea"></div>
                </div>
            </div>

            <!-- Info cabecera -->
            <div class="col-md text-center text-md-start mt-3 mt-md-0">
                <h2 class="fw-bold text-body-custom mb-1">@nombreCompleto</h2>

                <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 text-alef-primary fw-bold mb-2">
                    <i data-lucide="award" style="width: 18px; height: 18px;"></i>
                    <span>Explorador Neuro Pro</span>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-4 text-muted-custom small">
                    <span id="display-address-header">
                        <i data-lucide="map-pin" style="width: 14px; height: 14px; margin-right: 4px;"></i>
                        @ubicacion
                    </span>
                    <span>
                        <i data-lucide="calendar" style="width: 14px; height: 14px; margin-right: 4px;"></i>
                        Unido en @Model.FechaRegistro.Year
                    </span> @* 🔹 año real de registro *@
                </div>
            </div>

            <!-- Botón editar perfil -->
            <div class="col-md-auto mt-4 mt-md-0 text-center">
                <button type="button"
                        class="btn btn-alef-submit px-4 py-2 d-inline-flex align-items-center gap-2"
                        data-bs-toggle="modal"
                        data-bs-target="#editProfileModal">
                    <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i>
                    Editar Perfil
                </button>
            </div>
        </div>
    </div>
</div>

