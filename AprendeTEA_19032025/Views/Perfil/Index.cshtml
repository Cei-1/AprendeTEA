<!-- MODAL: Editar Perfil (Incluye foto) -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-bg">
            <div class="modal-header border-bottom border-secondary border-opacity-10">
                <h5 class="modal-title fw-bold text-alef-primary">Editar Información</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Actualizar" asp-controller="Perfil" method="post" id="editForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" asp-for="IdUsuario" />

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label small fw-bold text-muted-custom"></label>
                        <input asp-for="Telefono" class="form-control custom-input" id="editPhone" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <h6 class="fw-bold text-body-custom mt-4 mb-3">Dirección</h6>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label small fw-bold text-muted-custom"></label>
                        <input asp-for="Estado" class="form-control custom-input" id="editState" />
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Municipio" class="form-label small fw-bold text-muted-custom"></label>
                        <input asp-for="Municipio" class="form-control custom-input" id="editMunicipio" />
                        <span asp-validation-for="Municipio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Colonia" class="form-label small fw-bold text-muted-custom"></label>
                        <input asp-for="Colonia" class="form-control custom-input" id="editColonia" />
                        <span asp-validation-for="Colonia" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />

                    <!-- Foto -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted-custom">Foto de Perfil</label>
                        <input type="file" accept="image/*" class="form-control custom-input" id="fotoFile" />

                        <input type="hidden" asp-for="FotoBase64" id="FotoBase64" />

                        <div class="mt-3 text-center">
                            <img id="previewImg" src="@fotoPerfil"
                                 class="rounded shadow-sm"
                                 style="max-width: 140px; max-height: 140px; object-fit: cover;" />
                        </div>

                        <small class="text-muted-custom d-block mt-1">
                            Si no seleccionas una imagen nueva, se mantendrá la actual.
                        </small>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary border-opacity-10">
                    <button type="button" class="btn btn-cancel-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-alef-submit">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Conversión de foto a Base64
        const fotoFile = document.getElementById("fotoFile");
        const fotoBase = document.getElementById("FotoBase64");
        const previewImg = document.getElementById("previewImg");

        if (fotoFile) {
            fotoFile.addEventListener("change", function () {
                const file = this.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    const dataUrl = e.target.result;
                    const base64 = dataUrl.split(',')[1];

                    fotoBase.value = base64;
                    previewImg.src = dataUrl;
                };
                reader.readAsDataURL(file);
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }
        });
    </script>
}
