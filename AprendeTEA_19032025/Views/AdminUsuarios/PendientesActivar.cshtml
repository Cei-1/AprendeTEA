@model List<AprendeTEA_19032025.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios pendientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-body-custom mb-1">
            <i data-lucide="user-check" class="text-alef-primary me-2" style="width: 28px; height: 28px;"></i>
            Activación de Usuarios
        </h2>
        <p class="text-muted-custom small mb-0">Administra las cuentas que requieren confirmación manual.</p>
    </div>
    <div class="d-none d-md-block">
        <span class="badge bg-alef-primary-subtle text-alef-primary fs-6 px-3 py-2 rounded-pill">
            Total: @Model.Count
        </span>
    </div>
</div>

<div class="card-bg p-4 rounded-4 shadow-sm border border-secondary border-opacity-10">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3 shadow-sm border-0 bg-success bg-opacity-10 text-success" role="alert">
            <i data-lucide="check-circle" style="width: 20px;"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3 shadow-sm border-0 bg-danger bg-opacity-10 text-danger" role="alert">
            <i data-lucide="alert-circle" style="width: 20px;"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3 p-3 bg-light rounded-circle d-inline-block">
                <i data-lucide="inbox" class="text-muted" style="width: 40px; height: 40px;"></i>
            </div>
            <h5 class="text-muted fw-bold">Todo está al día</h5>
            <p class="text-muted small">No hay usuarios pendientes de confirmación en este momento.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-3">Usuario</th>
                        <th>Perfil</th>
                        <th>Registro</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-alef-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                         style="width: 40px; height: 40px; font-size: 1rem;">
                                        @u.Email?.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold text-body-custom">@u.Email</div>
                                        <div class="small text-muted-custom">ID: @u.IdUsuario</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="d-flex align-items-center gap-1 text-muted-custom fw-medium">
                                    <i data-lucide="shield" style="width: 14px;"></i> @u.NombrePerfil
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-body-custom fw-medium">@u.FechaRegistro.ToString("dd MMM yyyy")</span>
                                    <span class="small text-muted-custom">@u.FechaRegistro.ToString("HH:mm") hrs</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3">
                                    <i class="bi bi-clock me-1"></i> Pendiente
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-controller="AdminUsuarios" asp-action="ActivarManual" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                        <button type="submit" class="btn btn-sm btn-success text-white fw-bold d-flex align-items-center gap-2 shadow-sm" title="Activar Usuario">
                                            <i data-lucide="check" style="width: 16px;"></i>
                                            <span class="d-none d-md-inline">Activar</span>
                                        </button>
                                    </form>

                                    <form asp-controller="AdminUsuarios" asp-action="ReenviarConfirmacion" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary fw-bold d-flex align-items-center gap-2" title="Reenviar Correo">
                                            <i data-lucide="send" style="width: 16px;"></i>
                                            <span class="d-none d-lg-inline">Reenviar</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Asegurar que los iconos se rendericen al cargar la vista parcial o completa
        if (typeof lucide !== "undefined") {
            lucide.createIcons();
        }
    </script>
}